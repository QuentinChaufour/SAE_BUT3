{
  "name": "S5-SAE-Stages",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "nuxt:dev": "nuxt dev",
    "start": "docker compose -p ostages -f docker-compose.yml up -d --build",
    "dev": "docker compose -p ostages_dev -f docker-compose.dev.yml up --build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:migrate": "docker exec -it website-dev npx prisma migrate dev",
    "dev:migrate:reset": "docker exec -it website-dev npx prisma migrate reset",
    "dev:generate": "docker exec -it website-dev npx prisma generate",
    "db:migrate": "docker exec -it website npx prisma migrate deploy",
    "db:generate": "docker exec -it website npx prisma generate"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.146",
    "@iconify-json/simple-icons": "1.2.100",
    "@nuxt/ui": "4.12.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.8",
    "nuxt": "4.6.2",
    "nuxt-auth-utils": "0.5.32",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "10.13.0",
    "eslint-plugin-better-tailwindcss": "4.9.1",
    "happy-dom": "^21.0.3",
    "playwright-core": "^1.64.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.14.0"
}
